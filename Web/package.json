{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --testPathPatterns=tests/unit --passWithNoTests",
    "test:integration": "jest --testPathPatterns=tests/integration --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --no-error-on-unmatched-pattern --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"tests/**/*.ts\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"tests/**/*.ts\" --no-error-on-unmatched-pattern"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "motion": "^13.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^20.7.0",
    "@angular-eslint/schematics": "^20.7.0",
    "@angular/build": "^20.3.34",
    "@angular/cli": "^20.3.34",
    "@angular/compiler-cli": "^20.3.0",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/angular": "^18.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.9.0",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^17.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.4.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.16.0"
  }
}